# ==============================================================================
# BAYYORA (بيّورا) — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets.

# 1. Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Security Secrets
LEAD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. GoHighLevel (GHL) CRM Integration (Optional — falls back to local encrypted submission queue)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_URL=

# 4. Analytics & Tracking Pixels (Optional — loaded only after Saudi PDPL cookie consent)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
